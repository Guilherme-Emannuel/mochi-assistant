# Copy to .env (never commit .env). Values are placeholders.

# --- Database (dedicated role, see docs/setup/02-database.md) ---
MOCHI_DB_HOST=localhost
MOCHI_DB_PORT=5432
MOCHI_DB_NAME=mochi
MOCHI_DB_USER=mochi_app
MOCHI_DB_PASSWORD=change-me

# --- n8n webhook used by the desktop client ---
# Use the Tailscale MagicDNS name, never a public URL
MOCHI_WEBHOOK_URL=https://your-server.your-tailnet.ts.net/webhook/mochi
MOCHI_WEBHOOK_TOKEN=generate-with-openssl-rand-hex-32

# --- Locale ---
MOCHI_TIMEZONE=America/Campo_Grande
MOCHI_LOCALE=pt-BR
